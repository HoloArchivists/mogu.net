root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{json,xml,csproj,props,slnx}]
indent_size = 2

[*.cs]
# Structured logging via message templates is fine at our scale.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Razor PageModels and EF entities are public by design; URLs are strings in Razor.
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA2227.severity = none
dotnet_diagnostic.CA1819.severity = none
# ConfigureAwait is irrelevant in ASP.NET Core.
dotnet_diagnostic.CA2007.severity = none

[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
