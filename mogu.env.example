# Copy to mogu.env and fill in. Any appsettings.json key can be overridden here (":" becomes "__").
Discord__ClientId=
Discord__ClientSecret=
Discord__GuildId=
Discord__LoginRoles__0=
Discord__TrustedRoles__0=
Discord__ModeratorRoles__0=
Discord__AdminRoles__0=
Tracker__AnnounceUrl=https://mogu.holopirates.moe/announce
# nginx on the docker host reaches the container from the bridge network
ReverseProxy__KnownNetworks__0=172.16.0.0/12
